# Cloudflare Pages reads this from the build output root.
#
# Pages MERGES every rule whose pattern matches, and joins repeated header
# names with a comma rather than letting the more specific rule win. A
# catch-all `/*` carrying Cache-Control would therefore turn the immutable
# rules below into `max-age=31536000, immutable, public, max-age=0,
# must-revalidate`, which is nonsense. So the patterns here are deliberately
# non-overlapping, and `/*` sets only headers that no other rule sets.
#
# HTML gets no rule at all on purpose: the Pages default already serves it
# `public, max-age=0, must-revalidate`, which is what we would have written.

# Vite content-hashes everything under /assets/, so a changed file always
# arrives under a new name and can never be served stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Font filenames encode family, style, weight and subset, and the bytes behind
# a given name never change: adding a weight adds a file rather than editing
# one. Fonts are fetched in CORS mode even same-origin, hence the ACAO.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Portrait variants are not content-hashed, because portrait.duotone.jpeg has
# to keep its name for the Open Graph and schema.org tags that point at it. A
# week of caching plus a day of stale-while-revalidate keeps repeat views cheap
# without stranding a replaced photo in caches for a year.
/portrait*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Listed individually rather than as /*.png, which would also match anything
# Vite emits under /assets/ and comma-join two Cache-Control values onto it.
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon-16x16.png
  Cache-Control: public, max-age=2592000
/favicon-32x32.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/android-chrome-192x192.png
  Cache-Control: public, max-age=2592000
/android-chrome-512x512.png
  Cache-Control: public, max-age=2592000

# No Cache-Control here. See the note at the top.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
