{
  "name": "alexander-vervloet-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:dives && npm run build:images && vite",
    "sync:dives": "node scripts/sync-dives.mjs",
    "build:dives": "node scripts/build-dives.mjs",
    "build:images": "node scripts/build-images.mjs",
    "build": "npm run build:dives && npm run build:images && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/ssr && node scripts/prerender.mjs && node scripts/inject-analytics.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "markdown-it": "^15.0.0",
    "sharp": "^0.35.4",
    "shiki": "^4.4.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
